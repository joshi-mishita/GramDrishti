# Copy to .env to change these. Nothing here is secret; do not put secrets in this file.
# docker compose reads .env for the ports below and passes the GRAMDRISHTI_* values to the API.

# Only "mock" exists today (synthetic data). "real" needs real data files that are not connected.
DATA_MODE=mock

# Host address and ports. 127.0.0.1 keeps the demo on this laptop; 0.0.0.0 would expose it on the network.
BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
OFFLINE_PORT=8081
API_PORT=8000

# Browser origins allowed to call the API directly (comma-separated, "*" is refused). The web services
# proxy /api, so they need no entry; this is for a Vite dev server pointed straight at the container.
GRAMDRISHTI_CORS_ORIGINS=http://localhost:5173

# Largest request body the API accepts, in bytes (nginx also limits bodies to 64 KiB).
GRAMDRISHTI_MAX_BODY_BYTES=65536
