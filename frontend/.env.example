# Copy to .env.local and edit. Nothing here is secret.

# Base URL of the API. The default goes through the Vite proxy to http://localhost:8000.
# VITE_API_BASE=/api/v1

# Comma-separated endpoint groups served by the real API. Everything else reads
# public/mock/ (copied from contract/examples by `npm run sync:mock`).
# Groups: health, meta, geo, forecast, observed, explain, risk, priority,
#         advisories, audio, farmers, feedback, verification, impact, data-quality
# Since S7 the map and detail panel run on the API (needs the S6 snapshots, see CLAUDE.md).
# Since S9 risk, priority and advisories do too: reviewing (approve, edit, reject) needs
# the API, because the demo files are read-only.
# Since S11 verification and impact read the verification job's files through the API
# (backend/artifacts/verification.json and impact.json; the API answers 503 without them).
# Since S13 the farmer app can use farmers, feedback and audio too: add them to post
# "Did it rain today?" answers and to play the server's MP3 (else the phone's own voice).
# Leave empty to run everything on the demo files without a server.
VITE_REAL_ENDPOINTS=meta,geo,forecast,observed,explain,risk,priority,advisories,verification,impact

# 1 = read only from public/snapshot/ (exported by the backend). No server needed.
VITE_SNAPSHOT=

# Issue date shown first when the URL has none (must be in /meta.available_issue_dates).
# VITE_DEFAULT_ISSUE_DATE=2024-09-09
