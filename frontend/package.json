{
  "name": "gramdrishti-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "predev": "npm run sync:mock",
    "build": "tsc -b && vite build",
    "prebuild": "npm run sync:mock",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "gen:types": "openapi-typescript ../contract/openapi.json -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "check:types": "npm run gen:types && git diff --exit-code -- src/api/schema.d.ts",
    "sync:mock": "node scripts/sync-mock.mjs",
    "shots": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-gurmukhi": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@tanstack/react-query": "^5.103.2",
    "i18next": "^26.4.2",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "^6.11.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
